[sub_resource type="GDScript" id="GDScript_exbkk"]
script/source = "extends CanvasLayer


# Menus
@onready var main_menu: VBoxContainer = %MainMenu

# Buttons

@onready var back_to_title_screen_button: Button = %BackToTitleScreenButton
@onready var window_mode_button: Button = %WindowModeButton
@onready var apply_settings_button: Button = %ApplySettingsButton





# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	show_main_menu()
	back_to_title_screen_button.pressed.connect(switch_to_title_scene)
	

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass

func switch_to_title_scene() -> void:
	get_tree().change_scene_to_file(\"res://title_screen/title_screen.tscn\")
	pass
	
func switch_resolution(w:int, h:int) -> void:
	get_tree().change_scene_to_file(\"res://title_screen/title_screen.tscn\")
	pass

func show_main_menu() -> void:
	main_menu.visible = true
	back_to_title_screen_button.grab_focus()
	
	
"

